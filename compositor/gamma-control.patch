+/// Number of entries per channel of the CRTC's `GAMMA_LUT`, if supported.
+pub fn gamma_lut_size(dev: &impl ControlDevice, crtc: crtc::Handle) -> Option<u32> {
+    get_prop(dev, crtc, "GAMMA_LUT").ok()?;
+    let (_, size) = get_property_val(dev, crtc, "GAMMA_LUT_SIZE").ok()?;
+    u32::try_from(size).ok().filter(|size| *size > 1)
+}
+
+/// Program the CRTC's `GAMMA_LUT` from a ramp laid out as
+/// `n` red, `n` green, then `n` blue entries (as in wlr-gamma-control).
+/// The ramp is resampled if `n` differs from the CRTC's `GAMMA_LUT_SIZE`.
+/// `None` restores the default (linear) gamma.
+pub fn set_gamma_lut(
+    dev: &impl ControlDevice,
+    crtc: crtc::Handle,
+    ramp: Option<&[u16]>,
+) -> Result<()> {
+    let Some(ramp) = ramp else {
+        return clear_gamma(dev, crtc);
+    };
+    let prop = get_prop(dev, crtc, "GAMMA_LUT")?;
+    let size = gamma_lut_size(dev, crtc).context("Crtc has no GAMMA_LUT_SIZE")? as usize;
+    let n = ramp.len() / 3;
+    anyhow::ensure!(n > 1 && ramp.len() == n * 3, "Invalid gamma ramp length");
+
+    let sample = |channel: usize, i: usize| -> u16 {
+        let ramp = &ramp[channel * n..(channel + 1) * n];
+        if size == n {
+            return ramp[i];
+        }
+        let pos = i as f64 * (n - 1) as f64 / (size - 1) as f64;
+        let lo = pos.floor() as usize;
+        let hi = (lo + 1).min(n - 1);
+        let t = pos - lo as f64;
+        (ramp[lo] as f64 * (1.0 - t) + ramp[hi] as f64 * t).round() as u16
+    };
+
+    // struct drm_color_lut { u16 red, green, blue, reserved; }
+    let mut blob = Vec::with_capacity(size * 8);
+    for i in 0..size {
+        for value in [sample(0, i), sample(1, i), sample(2, i), 0] {
+            blob.extend_from_slice(&value.to_ne_bytes());
+        }
+    }
+    let blob = drm_ffi::mode::create_property_blob(dev.as_fd(), &mut blob)
+        .context("Failed to create GAMMA_LUT blob")?;
+    let result = dev.set_property(
+        crtc,
+        prop,
+        property::Value::Blob(blob.blob_id as u64).into(),
+    );
+    // The CRTC state holds its own reference to the blob.
+    let _ = dev.destroy_property_blob(blob.blob_id as u64);
+    result.context("Failed to set GAMMA_LUT")
+}
